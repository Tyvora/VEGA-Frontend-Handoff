{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vega.example/contracts/shared/common.schema.json",
  "$defs": {
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "scope",
        "retryable"
      ]
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "dec_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "frame": {
          "const": "ICRS"
        }
      },
      "required": [
        "ra_deg",
        "dec_deg",
        "frame"
      ]
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "conditional",
            "blocked",
            "not_evaluated"
          ]
        },
        "allow_preparation": {
          "type": "boolean"
        },
        "allow_scientific_execution": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "allow_preparation",
        "allow_scientific_execution",
        "reason_codes",
        "missing_requirements",
        "execution_conditions",
        "policy_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "conditional",
                  "blocked",
                  "not_evaluated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allow_scientific_execution": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blocked",
                  "not_evaluated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allow_preparation": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend_processing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "running",
                "completed",
                "partial",
                "failed",
                "cancelled"
              ]
            },
            "progress_fraction": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "stage": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "progress_fraction",
            "stage"
          ]
        },
        "data_readiness": {
          "$ref": "#/$defs/Readiness"
        },
        "algorithm_execution": {
          "enum": [
            "not_implemented",
            "not_run",
            "running",
            "completed",
            "failed"
          ]
        },
        "scientific_validation": {
          "enum": [
            "not_evaluated",
            "unvalidated",
            "validated",
            "rejected"
          ]
        },
        "ui_availability": {
          "enum": [
            "loading",
            "available",
            "partial",
            "empty",
            "unavailable",
            "error"
          ]
        }
      },
      "required": [
        "backend_processing",
        "data_readiness",
        "algorithm_execution",
        "scientific_validation",
        "ui_availability"
      ]
    },
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "available",
            "conditional",
            "unavailable"
          ]
        },
        "allow_interaction": {
          "type": "boolean"
        },
        "implementation_status": {
          "enum": [
            "implemented",
            "planned",
            "mock_only"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "availability",
        "allow_interaction",
        "implementation_status",
        "reason_codes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "allow_interaction": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "input_method": {
          "enum": [
            "name",
            "coordinates",
            "preset"
          ]
        },
        "original_input": {},
        "target_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fov_semantics": {
          "const": "circular angular diameter"
        },
        "goal": {
          "enum": [
            "sky_viewer",
            "timeline",
            "discoveries"
          ]
        }
      },
      "required": [
        "target_id",
        "input_method",
        "original_input",
        "target_name",
        "canonical_name",
        "position",
        "fov_deg",
        "fov_semantics",
        "goal"
      ]
    },
    "Asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "format": "uri-reference",
          "minLength": 1
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/svg+xml",
            "application/json",
            "application/x-dzi",
            "application/fits"
          ]
        },
        "purpose": {
          "enum": [
            "display_preview",
            "display_tiles",
            "scientific_original",
            "evidence"
          ]
        },
        "availability": {
          "enum": [
            "fixture",
            "proposed",
            "published"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset_id",
        "href",
        "media_type",
        "purpose",
        "availability",
        "sha256"
      ]
    },
    "Time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iso_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "mjd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "enum": [
            "UTC",
            "TAI",
            "TT",
            "TDB",
            "unknown"
          ]
        },
        "unit": {
          "const": "d"
        }
      },
      "required": [
        "iso_utc",
        "mjd",
        "scale",
        "unit"
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "detector": {
          "anyOf": [
            {
              "enum": [
                "D1",
                "D2",
                "D3",
                "D4",
                "D5",
                "D6"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "bandpass": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "processing_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "$ref": "#/$defs/Time"
        },
        "end": {
          "$ref": "#/$defs/Time"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "wcs_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "is_mock": {
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "product_id",
        "collection",
        "detector",
        "bandpass",
        "processing_version",
        "start",
        "end",
        "preview",
        "wcs_reference",
        "quality_reference",
        "is_mock"
      ]
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "MJy/sr",
            "(MJy/sr)^2",
            "Jy",
            "arcsec",
            "mas/yr",
            "deg",
            "d",
            "m",
            "um",
            "pixel"
          ]
        },
        "uncertainty_status": {
          "enum": [
            "reported",
            "not_reported",
            "not_applicable"
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "uncertainty_status",
        "uncertainty",
        "method",
        "method_version"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "uncertainty_status": {
                "const": "reported"
              }
            }
          },
          "then": {
            "properties": {
              "uncertainty": {
                "type": "number",
                "minimum": 0
              },
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "uncertainty": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synthetic": {
          "type": "boolean"
        },
        "source_service": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "method_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "synthetic",
        "source_service",
        "references",
        "method",
        "method_version",
        "limitations",
        "validation_reference"
      ]
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "next_cursor",
        "has_more",
        "returned"
      ]
    },
    "Envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "interface",
        "is_mock",
        "data_origin",
        "request_id",
        "run_id",
        "target",
        "state",
        "features",
        "warnings",
        "errors",
        "provenance",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "interface": {
          "enum": [
            "sky_viewer",
            "timeline",
            "discoveries"
          ]
        },
        "is_mock": {
          "type": "boolean"
        },
        "data_origin": {
          "enum": [
            "mock",
            "archive_metadata",
            "science_result"
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Feature"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "is_mock": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "data_origin": {
                "const": "mock"
              },
              "provenance": {
                "properties": {
                  "synthetic": {
                    "const": true
                  }
                }
              },
              "state": {
                "properties": {
                  "scientific_validation": {
                    "enum": [
                      "not_evaluated",
                      "unvalidated"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "data_origin": {
                "enum": [
                  "archive_metadata",
                  "science_result"
                ]
              },
              "provenance": {
                "properties": {
                  "synthetic": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "properties": {
                  "scientific_validation": {
                    "const": "validated"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "data_origin": {
                "const": "science_result"
              },
              "is_mock": {
                "const": false
              },
              "state": {
                "properties": {
                  "algorithm_execution": {
                    "const": "completed"
                  },
                  "data_readiness": {
                    "properties": {
                      "allow_scientific_execution": {
                        "const": true
                      },
                      "status": {
                        "const": "ready"
                      }
                    }
                  }
                }
              },
              "provenance": {
                "properties": {
                  "validation_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "references": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "properties": {
                  "ui_availability": {
                    "const": "error"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "properties": {
                  "ui_availability": {
                    "const": "loading"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "properties": {
                  "backend_processing": {
                    "properties": {
                      "status": {
                        "enum": [
                          "pending",
                          "running"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "TargetInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_method": {
          "enum": [
            "name",
            "coordinates",
            "preset"
          ]
        },
        "value": {},
        "goal": {
          "enum": [
            "sky_viewer",
            "timeline",
            "discoveries"
          ]
        },
        "fov_deg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_method",
        "value",
        "goal",
        "fov_deg"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "input_method": {
                "enum": [
                  "name",
                  "preset"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ra": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "dec": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                },
                "required": [
                  "ra",
                  "dec"
                ]
              }
            }
          }
        }
      ]
    },
    "StartRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_product_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "search_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "request_id",
        "search_id",
        "selected_product_ids",
        "idempotency_key"
      ]
    },
    "Job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "partial",
            "failed",
            "cancelled"
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_products": {
          "type": "integer",
          "minimum": 0
        },
        "selected_products": {
          "type": "integer",
          "minimum": 0
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        }
      },
      "required": [
        "request_id",
        "run_id",
        "status",
        "stage",
        "completed_products",
        "selected_products",
        "cancel_requested",
        "errors"
      ]
    },
    "PixelQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
