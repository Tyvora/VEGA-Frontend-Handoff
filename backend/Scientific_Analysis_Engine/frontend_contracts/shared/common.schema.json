            "failed"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          }
        },
        "page": {
          "$ref": "#/$defs/Page"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        }
      },
      "required": [
