      ]
    },
    "ScientificProduct": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "enum": [
            "background_estimation",
            "source_detection",
            "astrometry",
            "photometry",
            "observation_compatibility",
            "image_registration",
            "cross_matching",
            "change_detection",
            "motion_detection",
            "candidate_assessment"
          ]
        },
        "product_type": {
          "enum": [
            "background_model",
            "source_catalog",
            "astrometric_solution",
            "photometry_table",
            "compatibility_assessment",
            "registered_image",
            "crossmatch_table",
            "difference_image",
            "motion_track",
            "candidate_assessment"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "product_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Position"
          }
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainty_status": {
          "enum": [
            "reported",
            "not_reported",
            "not_applicable"
          ]
        },
        "validation_status": {
          "enum": [
            "unvalidated",
            "validated",
            "rejected"
          ]
        },
        "is_mock": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "result_id",
        "algorithm",
        "product_type",
        "method",
        "method_version",
        "product_ids",
        "observation_ids",
        "asset",
        "measurements",
        "positions",
        "related_ids",
        "uncertainty_status",
        "validation_status",
        "is_mock",
        "provenance"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "background_estimation"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "background_model"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "source_detection"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "source_catalog"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "astrometry"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "astrometric_solution"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "photometry"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "photometry_table"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "observation_compatibility"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "compatibility_assessment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "image_registration"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "registered_image"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "cross_matching"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "crossmatch_table"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "change_detection"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "difference_image"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "motion_detection"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "motion_track"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "candidate_assessment"
              }
            }
          },
          "then": {
            "properties": {
              "product_type": {
                "const": "candidate_assessment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_mock": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "validation_status": {
                "const": "unvalidated"
              },
              "provenance": {
                "properties": {
                  "synthetic": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "validation_status": {
                "const": "validated"
              }
            }
          },
          "then": {
            "properties": {
              "is_mock": {
                "const": false
              },
              "provenance": {
                "properties": {
                  "synthetic": {
                    "const": false
                  },
                  "validation_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "references": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_mock": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "synthetic": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_mock": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "asset": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/PublishedAsset"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ResolveResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
